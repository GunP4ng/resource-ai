{
  "name": "resource-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Re:Source AI implementation contracts and verified senpi scaffold",
  "engines": { "node": ">=24.0.0" },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build src/extension.ts --target=bun --packages=external --outdir=dist",
    "smoke": "bun scripts/smoke.ts"
  },
  "pi": {
    "extensions": ["./src/extension.ts"],
    "skills": ["./skills"]
  },
  "dependencies": {
    "@code-yeongyu/senpi": "2026.11.4-2",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
