# Server-side only. Copy locally; never commit real values.
# Default launcher uses the existing senpi ChatGPT subscription login.
# subscription | azure | local (local disables model calls)
RESOURCE_MODEL_RUNNER=subscription
# Optional static SDK model ID; subscription default is gpt-5.5.
# RESOURCE_MODEL_ID=gpt-5.5
# Optional absolute SDK auth.json path. Unset uses SDK discovery.
# RESOURCE_AUTH_PATH=/absolute/path/to/auth.json
# Azure is optional and only selected with RESOURCE_MODEL_RUNNER=azure.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
# Example format: gpt-4.1=your-verified-deployment-name
AZURE_OPENAI_DEPLOYMENT_NAME_MAP=
# Pinned senpi adapter defaults to v1. Do not copy old dated examples.
AZURE_OPENAI_API_VERSION=v1
# Application-owned absolute directory; never a developer's shared senpi home.
RESOURCE_AGENT_DIR=
